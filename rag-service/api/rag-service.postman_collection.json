    "name": "FoC RAG Service",
    "description": "The help bot demo: answers with sources, refusals, denied requests and the rate limit. Import together with local.postman_environment.json; see the README. Uses the real model, so a real key is needed, and each question costs a tiny amount.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 Answers with sources",
      "item": [
        {
          "name": "How do credits work?",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{ragServiceUrl}}/assistant/questions",
            "description": "A plain FAQ question.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"How do credits work?\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('answered', () => pm.expect(body.answered).to.equal(true));",
                  "pm.test('names a source', () => pm.expect(body.sources).to.be.an('array').and.not.empty);",
                  "pm.test('each source has a title and section', () => body.sources.forEach((s) => pm.expect(s).to.have.keys('title', 'section')));"
                ]
              }
            }
          ]
        },
