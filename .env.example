# ─────────────────────────────────────────────────────────────
# FoC — Friend on Campus · Environment configuration (EXAMPLE)
# ─────────────────────────────────────────────────────────────
# Single source of truth for ALL services. Copy to `.env` at the repo root:
#   cp .env.example .env
# Run compose from the root (`docker compose up`); root compose.yaml passes
# this file to every included service compose. Per-service .env files are gone.
#
# `.env` is git-ignored — NEVER commit real secrets. Passwords/keys live in
# `<service>/secrets/*.secret` (Docker secrets), not here.
# Keys that repeat across services are prefixed with the service name.
# Any variable a service reads MUST be mapped here.
# ─────────────────────────────────────────────────────────────

# ---- Global -------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# ---- Shared infra -------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_DB_INDEX=0

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/foc
# One RabbitMQ user per service. Passwords: rabbitmq_user_password,
# rabbitmq_email_password secrets (see each service's secrets/ folder).
USER_SERVICE_RABBITMQ_USER=user-service
EMAIL_SERVICE_RABBITMQ_USER=email-service

# ---- user-service -------------------------------------------
USER_SERVICE_DB_HOST=user-db
USER_SERVICE_DB_PORT=5432
USER_SERVICE_DB_USERNAME=foc
USER_SERVICE_DB_DATABASE=foc_user
USER_SERVICE_DB_SYNCHRONIZE=true # dev only
# Admin bootstrap; provisioned only if no other admins exist (omit to skip)
ADMIN_BOOTSTRAP_EMAIL=admin@foc.sg
ADMIN_BOOTSTRAP_DISPLAY_NAME=FoC System Admin

# ---- email-service ------------------------------------------
SMTP_HOST=papercut
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=foc
SMTP_FROM_EMAIL=noreply@foc.local

# ---- order-service ------------------------------------------
ORDER_SERVICE_HOST_PORT=3004
ORDER_SERVICE_DB_HOST=order-db
ORDER_SERVICE_DB_PORT=5432
ORDER_SERVICE_DB_HOST_PORT=5436
ORDER_SERVICE_DB_USERNAME=order_service
ORDER_SERVICE_DB_DATABASE=order_service
ORDER_SERVICE_DB_SYNCHRONIZE=true

# ---- credit-service -----------------------------------------
CREDIT_SERVICE_PORT=3000
CREDIT_SERVICE_HOST_PORT=3003
CREDIT_SERVICE_DB_HOST=credit-db
CREDIT_SERVICE_DB_PORT=5432
CREDIT_SERVICE_DB_HOST_PORT=5435
CREDIT_SERVICE_DB_USERNAME=credit_service
CREDIT_SERVICE_DB_DATABASE=credit_service

# ---- Frontend -----------------------------------------------
# Where the Next.js server proxies /api/auth/*
USER_SERVICE_URL=http://user-service:3000
