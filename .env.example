# ─────────────────────────────────────────────────────────────
# FoC — Friend on Campus · Environment configuration (EXAMPLE)
# ─────────────────────────────────────────────────────────────
# Copy to `.env` and fill in real values:   cp .env.example .env
#
# `.env` is git-ignored — NEVER commit real secrets.
# Any variable read by any service MUST appear here with a safe
# placeholder so teammates know what to set.
#
# This is just an example; you can add more variables as needed.
# ─────────────────────────────────────────────────────────────

# ---- Global -------------------------------------------------
LOG_LEVEL=

# ---- Auth / JWT -----------
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=
JWT_REFRESH_TOKEN_TTL=

# ---- Supplier Service -----------------------------------------
# Prefixed so they cannot collide with other services' DB_* values;
# supplier-service/compose.yml maps them onto the app's DB_* names.
# Full reference: supplier-service/.env.example
SUPPLIER_SERVICE_HOST_PORT=3002
SUPPLIER_LOG_LEVEL=log
SUPPLIER_DB_USERNAME=supplier_service
SUPPLIER_DB_DATABASE=supplier_service
SUPPLIER_DB_HOST_PORT=5438
SUPPLIER_DB_TEST_HOST_PORT=5439
SUPPLIER_DB_MIGRATIONS_RUN=true

# ... Add more variables as needed
