# ---- Docker Compose (docker compose up) ------------------------------------
# Interpolated by compose.yml. Put these in the root .env when running the
# whole project, or in supplier-service/.env when running this service alone.
SUPPLIER_SERVICE_HOST_PORT=3002
SUPPLIER_LOG_LEVEL=log
SUPPLIER_DB_USERNAME=supplier_service
SUPPLIER_DB_DATABASE=supplier_service
SUPPLIER_DB_HOST_PORT=5438
SUPPLIER_DB_TEST_HOST_PORT=5439
SUPPLIER_DB_MIGRATIONS_RUN=true
SUPPLIER_CAMPUS_MIN_LATITUDE=1.28
SUPPLIER_CAMPUS_MAX_LATITUDE=1.31
SUPPLIER_CAMPUS_MIN_LONGITUDE=103.74
SUPPLIER_CAMPUS_MAX_LONGITUDE=103.79
SUPPLIER_SEED_ON_STARTUP=true
# user-service's JWT public key file (relative to supplier-service/). Read only:
# it must be the exact key user-service signs with, so point at its own file.
SUPPLIER_JWT_PUBLIC_KEY_PATH=../user-service/jwt_public_key.secret

# ---- Read by the app itself -------------------------------------------------
# Compose sets these inside the container. Set them here only to run the app
# or the migration CLI directly on your machine (npm run start:dev,
# npm run migration:*), pointing at the compose database's host port.
NODE_ENV=development
PORT=3000
# fatal | error | warn | log | debug | verbose (each includes the ones before)
LOG_LEVEL=log
DB_HOST=localhost
DB_PORT=5438
DB_USERNAME=supplier_service
DB_DATABASE=supplier_service
DB_PASSWORD_FILE=./secrets/supplier_db_password.secret
# Apply pending migrations on startup (schema is never auto-synchronized)
DB_MIGRATIONS_RUN=true
# NUS campus bounding box every supplier's coordinates must lie in (F1.2.7)
CAMPUS_MIN_LATITUDE=1.28
CAMPUS_MAX_LATITUDE=1.31
CAMPUS_MIN_LONGITUDE=103.74
CAMPUS_MAX_LONGITUDE=103.79
# Import the supplier seed file on startup (safe to re-run: existing ones skip)
SEED_ON_STARTUP=true
SEED_CSV_PATH=../data/csv/supplier-seed-data.csv
# user-service's JWT public key (PEM), to verify login tokens
JWT_PUBLIC_KEY_FILE=../user-service/jwt_public_key.secret
