{
  "name": "order-service",
  "version": "0.0.1",
  "description": "Order service for Friend on Campus",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "contracts:build": "npm run build --prefix ../packages/contracts",
    "contracts:install": "npm install --no-audit --no-fund --prefix ../packages/contracts",
    "postinstall": "npm run contracts:install",
    "prebuild": "npm run contracts:build",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "prestart": "npm run contracts:build",
    "start": "nest start",
    "prestart:dev": "npm run contracts:build",
    "start:dev": "nest start --watch --preserveWatchOutput",
    "prestart:debug": "npm run contracts:build",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint src/ test/",
    "pretest": "npm run contracts:build",
    "test": "vitest run",
    "pretest:watch": "npm run contracts:build",
    "test:watch": "vitest",
    "pretest:cov": "npm run contracts:build",
    "test:cov": "vitest run --coverage",
    "pretest:debug": "npm run contracts:build",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "pretest:e2e": "npm run contracts:build",
    "test:messaging": "vitest run --config ./vitest.config.messaging.ts",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@foc/contracts": "file:../packages/contracts",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "ajv": "^8.20.0",
    "amqplib": "^2.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "drizzle-orm": "^0.45.3",
    "joi": "^18.2.9",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/amqplib": "^0.10.8",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.2",
    "drizzle-kit": "^0.31.11",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  }
}
