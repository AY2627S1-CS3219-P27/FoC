{
  "name": "@foc/outbox",
  "version": "1.0.0",
  "description": "Shared transactional outbox relay for Friend on Campus services",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./outbox-event.entity": {
      "types": "./dist/outbox-event.entity.d.ts",
      "default": "./dist/outbox-event.entity.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "npm run clean",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; for (const path of ['dist', 'tsconfig.build.tsbuildinfo']) rmSync(path, { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "oxlint --type-aware src/"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "amqplib": "^2.0.1",
    "joi": "^18.2.9",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.0.1",
    "@types/amqplib": "^0.10.8",
    "@types/node": "^24.0.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "reflect-metadata": "^0.2.2",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
