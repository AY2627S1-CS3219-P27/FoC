{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foc.local/schemas/credit-settlement.v1.schema.json",
  "title": "CreditSettlementV1",
  "allOf": [
    {
      "$ref": "https://foc.local/schemas/event-envelope.v1.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "CreditSettlementRequested"
        },
        "publisher": {
          "const": "order-service"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "errandId",
            "requesterUserId",
            "courierUserId",
            "courierAmount",
            "requesterAmount",
            "attempt"
          ],
          "properties": {
            "errandId": {
              "type": "string",
              "format": "uuid"
            },
            "requesterUserId": {
              "type": "string",
              "format": "uuid"
            },
            "courierUserId": {
              "type": "string",
              "format": "uuid"
            },
            "courierAmount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "requesterAmount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "attempt": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        }
      }
    }
  ]
}
