{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foc.local/schemas/credit-reservation-adjustment-success.v1.schema.json",
  "title": "CreditReservationAdjustmentSuccessV1",
  "allOf": [
    { "$ref": "https://foc.local/schemas/event-envelope.v1.schema.json" },
    {
      "type": "object",
      "properties": {
        "eventType": { "const": "CreditReservationAdjustmentSuccess" },
        "publisher": { "const": "credit-service" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["errandId", "newReservedAmount", "creditTransactionId"],
          "properties": {
            "errandId": { "type": "string", "format": "uuid" },
            "newReservedAmount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "creditTransactionId": { "type": "string", "format": "uuid" }
          }
        }
      }
    }
  ]
}
