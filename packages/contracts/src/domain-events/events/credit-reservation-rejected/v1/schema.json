{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foc.local/schemas/credit-reservation-rejected.v1.schema.json",
  "title": "CreditReservationRejectedV1",
  "allOf": [
    { "$ref": "https://foc.local/schemas/event-envelope.v1.schema.json" },
    {
      "type": "object",
      "properties": {
        "eventType": { "const": "CreditReservationRejected" },
        "publisher": { "const": "credit-service" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "errandId",
            "requesterUserId",
            "requestedAmount",
            "rejectionReason"
          ],
          "properties": {
            "errandId": { "type": "string", "format": "uuid" },
            "requesterUserId": { "type": "string", "format": "uuid" },
            "requestedAmount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "rejectionReason": {
              "enum": [
                "MISSING_BALANCE",
                "INSUFFICIENT_CREDITS",
                "RESERVATION_CONFLICT"
              ]
            }
          }
        }
      }
    }
  ]
}
