{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foc.local/schemas/errand-cancelled.v1.schema.json",
  "title": "ErrandCancelledV1",
  "allOf": [
    {
      "$ref": "https://foc.local/schemas/event-envelope.v1.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "ErrandCancelled"
        },
        "publisher": {
          "const": "order-service"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "errandId"
          ],
          "properties": {
            "errandId": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      }
    }
  ]
}
