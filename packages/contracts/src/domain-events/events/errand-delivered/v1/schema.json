{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foc.local/schemas/errand-delivered.v1.schema.json",
  "title": "ErrandDeliveredV1",
  "allOf": [
    {
      "$ref": "https://foc.local/schemas/event-envelope.v1.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "ErrandDelivered"
        },
        "publisher": {
          "const": "order-service"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["errandId", "requesterUserId", "courierUserId"],
          "properties": {
            "errandId": {
              "type": "string",
              "format": "uuid"
            },
            "requesterUserId": {
              "type": "string",
              "format": "uuid"
            },
            "courierUserId": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      }
    }
  ]
}
