{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foc.local/schemas/credit-settlement-succeeded.v1.schema.json",
  "title": "CreditSettlementSucceededV1",
  "allOf": [
    {
      "$ref": "https://foc.local/schemas/event-envelope.v1.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "CreditSettlementSucceeded"
        },
        "publisher": {
          "const": "credit-service"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "required": ["courierAmount"],
                "properties": {
                  "courierAmount": { "const": 0 }
                }
              },
              "then": {
                "properties": {
                  "courierCreditTransactionId": { "type": "null" }
                }
              },
              "else": {
                "properties": {
                  "courierCreditTransactionId": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              }
            },
            {
              "if": {
                "required": ["requesterAmount"],
                "properties": {
                  "requesterAmount": { "const": 0 }
                }
              },
              "then": {
                "properties": {
                  "requesterCreditTransactionId": { "type": "null" }
                }
              },
              "else": {
                "properties": {
                  "requesterCreditTransactionId": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              }
            }
          ],
          "anyOf": [
            {
              "properties": {
                "courierAmount": { "type": "integer", "minimum": 1 }
              }
            },
            {
              "properties": {
                "requesterAmount": { "type": "integer", "minimum": 1 }
              }
            }
          ],
          "required": [
            "errandId",
            "requesterUserId",
            "courierUserId",
            "courierAmount",
            "requesterAmount",
            "courierCreditTransactionId",
            "requesterCreditTransactionId"
          ],
          "properties": {
            "errandId": {
              "type": "string",
              "format": "uuid"
            },
            "requesterUserId": {
              "type": "string",
              "format": "uuid"
            },
            "courierUserId": {
              "type": "string",
              "format": "uuid"
            },
            "courierAmount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "requesterAmount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "courierCreditTransactionId": {
              "type": ["string", "null"]
            },
            "requesterCreditTransactionId": {
              "type": ["string", "null"]
            }
          }
        }
      }
    }
  ]
}
