{
  "name": "@foc/observability",
  "version": "1.0.0",
  "description": "Shared observability (OpenTelemetry tracing + Prometheus metrics) for Friend on Campus services",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "npm run clean",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; for (const path of ['dist', 'tsconfig.build.tsbuildinfo']) rmSync(path, { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "oxlint --type-aware src/"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-logs-otlp-http": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/instrumentation-amqplib": "^0.70.0",
    "@opentelemetry/instrumentation-express": "^0.71.1",
    "@opentelemetry/instrumentation-http": "^0.223.0",
    "@opentelemetry/instrumentation-nestjs-core": "^0.70.0",
    "@opentelemetry/instrumentation-pg": "^0.76.0",
    "@opentelemetry/instrumentation-pino": "^0.69.0",
    "@opentelemetry/instrumentation-redis": "^0.71.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-logs": "^0.223.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prometheus-io/client": "^0.16.1",
    "pino-pretty": "^13.2.0"
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "^2.12.0",
    "@types/node": "^24.0.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
