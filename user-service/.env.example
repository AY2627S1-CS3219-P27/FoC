NODE_ENV={ RUNTIME MODE: development | test | production, default development }

DB_HOST={YOUR DB HOST NAME HERE}
DB_PORT={YOUR DB PORT HERE}
DB_USERNAME={YOUR DB USERNAME HERE}
DB_DATABASE={YOUR DB NAME HERE}
DB_PASSWORD_FILE_CLIENT={FILE PATH WHERE DB PASSWORD FILE IS MOUNTED FOR CLIENT}
DB_PASSWORD_FILE={FILE PATH WHERE DB PASSWORD FILE IS MOUNTED FOR DBMS}
DB_SYNCHRONIZE={ true | false, default false; TypeORM syncs schema from entities on startup - dev convenience only }

# Admin bootstrap flow; provisioned only if no other admins exist
ADMIN_BOOTSTRAP_EMAIL={ EMAIL OF INITIAL ADMIN, e.g. admin@foc.sg; omit to skip }
ADMIN_BOOTSTRAP_DISPLAY_NAME={ DISPLAY NAME OF INITIAL ADMIN, e.g. FoC System Admin; omit to skip }

REDIS_HOST={YOUR REDIS HOST NAME HERE}
REDIS_PORT={YOUR REDIS PORT HERE}
REDIS_USERNAME={YOUR REDIS USERNAME HERE}
REDIS_DB_INDEX={YOUR REDIS DB INDEX HERE}

SERVER_SECRET_FILE={FILE PATH WHERE SERVER SECRET FILE IS MOUNTED}

RABBITMQ_USER={ USER TO ACCESS RABBITMQ WITH }
RABBITMQ_HOST={ HOST OF RABBITMQ }
RABBITMQ_PORT={ PORT OF RABBITMQ }
RABBITMQ_VHOST={ VHOST INTEDED TO USE WITH USER SERVICE }
RABBITMQ_PASSWORD_FILE={ FILE PATH WHERE RABBITMQ USER PASSWORD IS MOUNTED }

LOG_LEVEL={ LOG LEVEL: debug | info | warn | error | fatal, default info; log=info, verbose=debug }

JWT_PRIVATE_KEY_FILE={ FILE PATH WHERE JWT PRIVATE KEY IS MOUNTED, e.g. /run/secrets/jwt_private_key }
JWT_PUBLIC_KEY_FILE={ FILE PATH WHERE JWT PUBLIC KEY IS MOUNTED, e.g. /run/secrets/jwt_public_key }
