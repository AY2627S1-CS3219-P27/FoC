{
  "name": "user-service",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "contracts:build": "npm run build --prefix ../packages/contracts",
    "contracts:install": "npm install --no-audit --no-fund --prefix ../packages/contracts",
    "auth:deps": "npm install --no-audit --no-fund --prefix ../packages/auth",
    "auth:build": "npm run build --prefix ../packages/auth",
    "auth:link": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('node_modules/@foc/auth', { recursive: true, force: true })\" && npm install --install-links --no-save --no-audit --no-fund ../packages/auth",
    "outbox:deps": "npm install --no-audit --no-fund --prefix ../packages/outbox",
    "outbox:build": "npm run build --prefix ../packages/outbox",
    "outbox:link": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('node_modules/@foc/outbox', { recursive: true, force: true })\" && npm install --install-links --no-save --no-audit --no-fund ../packages/outbox",
    "obs:deps": "npm install --no-audit --no-fund --prefix ../packages/observability",
    "obs:build": "npm run build --prefix ../packages/observability",
    "obs:link": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('node_modules/@foc/observability', { recursive: true, force: true })\" && npm install --install-links --no-save --no-audit --no-fund ../packages/observability",
    "shared:prepare": "npm run contracts:build && npm run auth:build && npm run outbox:build && npm run auth:link && npm run outbox:link && npm run obs:build && npm run obs:link",
    "postinstall": "npm run contracts:install && npm run auth:deps && npm run outbox:deps && npm run obs:deps",
    "prebuild": "npm run shared:prepare",
    "build": "nest build",
    "prestart": "npm run shared:prepare",
    "start": "nest start",
    "prestart:dev": "npm run shared:prepare",
    "start:dev": "nest start --watch --preserveWatchOutput",
    "prestart:debug": "npm run shared:prepare",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "oxlint --type-aware src/ test/",
    "pretest": "npm run shared:prepare",
    "test": "vitest run",
    "pretest:watch": "npm run shared:prepare",
    "test:watch": "vitest",
    "pretest:cov": "npm run shared:prepare",
    "test:cov": "vitest run --coverage",
    "pretest:debug": "npm run shared:prepare",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "pretest:e2e": "npm run shared:prepare",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@foc/auth": "file:../packages/auth",
    "@foc/contracts": "file:../packages/contracts",
    "@foc/observability": "file:../packages/observability",
    "@foc/outbox": "file:../packages/outbox",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/microservices": "^12.0.4",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/typeorm": "^12.0.1",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^2.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "joi": "^18.2.9",
    "nestjs-pino": "^5.3.1",
    "pg": "^8.23.0",
    "redis": "^6.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  }
}
