SMTP_HOST=
SMTP_PORT={ PORT OF SMTP SERVER }
SMTP_SECURE={ }
SMTP_USER={ USER NAME OF SMTP SERVER }
SMTP_PASS_FILE={ DIRECTORY TO FILE INCLUDING PASSWORD OF SMTP SERVER }
SMTP_FROM_EMAIL={ EMAIL TO SEND MAILS FROM }
LOG_LEVEL={ LOG LEVEL: trace | debug | info | warn | error | fatal, default info; log=info, verbose=debug }
