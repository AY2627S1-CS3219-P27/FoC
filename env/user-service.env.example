# user-service (EXAMPLE) — combine with shared.env when running compose.
# Copy to user-service.env: cp user-service.env.example user-service.env

USER_SERVICE_DB_HOST=user-db
USER_SERVICE_DB_PORT=5432
USER_SERVICE_DB_USERNAME=foc
USER_SERVICE_DB_DATABASE=foc_user
USER_SERVICE_DB_SYNCHRONIZE=true # dev only

# Admin bootstrap; provisioned only if no other admins exist (omit to skip)
ADMIN_BOOTSTRAP_EMAIL=admin@foc.sg
ADMIN_BOOTSTRAP_DISPLAY_NAME=FoC System Admin

# RabbitMQ identity for this service (password: user-service/secrets/rabbitmq_user_password.secret)
USER_SERVICE_RABBITMQ_USER=user-service
