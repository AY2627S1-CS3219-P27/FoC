# user-service (EXAMPLE) — combine with shared.env when running compose.
# Copy to user-service.env: cp user-service.env.example user-service.env

USER_SERVICE_DB_HOST=user-db
USER_SERVICE_DB_PORT=5432
USER_SERVICE_DB_USERNAME=foc
USER_SERVICE_DB_DATABASE=foc_user
USER_SERVICE_DB_SYNCHRONIZE=true # dev only

# Admin bootstrap; provisioned only if no other admins exist (omit to skip)
ADMIN_BOOTSTRAP_EMAIL=admin@foc.sg
ADMIN_BOOTSTRAP_DISPLAY_NAME=FoC System Admin

# RabbitMQ identity for this service (password: user-service/secrets/rabbitmq_user_password.secret)
USER_SERVICE_RABBITMQ_USER=user-service

# Transactional outbox relay (publishes committed domain events to foc.events)
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
OUTBOX_CONFIRM_TIMEOUT_MS=20000
OUTBOX_CLAIM_LEASE_MS=30000
OUTBOX_RETRY_BASE_DELAY_MS=1000
OUTBOX_RETRY_MAX_DELAY_MS=60000
OUTBOX_UNPUBLISHED_WARNING_MS=60000

# Used to build password-reset links (required)
FRONTEND_BASE_URL=http://localhost:3001
FRONTEND_PASSWORD_RESET_PATH=/reset-password

# order-service base URL, called to check/block a user's participant roles
# before a role change (in the compose network the service listens on 3000)
ORDER_SERVICE_BASE_URL=http://order-service:3000
