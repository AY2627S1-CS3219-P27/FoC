# ─────────────────────────────────────────────────────────────
# FoC — shared config (EXAMPLE)
# Loaded by every service alongside its own env/<service>.env.
# Copy to shared.env: cp shared.env.example shared.env
# ─────────────────────────────────────────────────────────────

# ---- Global ---------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# ---- Redis (shared cache) --------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_DB_INDEX=0

# ---- RabbitMQ broker (shared connection; each service's own
# credentials live in its own env/<service>.env) ------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/foc

# ---- Observability (shared) --------------------------------------
# OTLP/HTTP trace endpoint (Tempo in the dev stack; when running the apps
# outside Docker, point it at your own OTLP receiver or leave the default).
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318
# OTLP/HTTP logs endpoint (Loki in the dev stack). Leaving it unset disables
# log shipping entirely, which is what you want when running the apps outside
# Docker without a logs backend.
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://loki:3100/otlp/v1/logs
