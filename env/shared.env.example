# ─────────────────────────────────────────────────────────────
# FoC — shared config (EXAMPLE)
# Loaded by every service alongside its own env/<service>.env.
# Copy to shared.env: cp shared.env.example shared.env
# ─────────────────────────────────────────────────────────────

# ---- Global ---------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# ---- Redis (shared cache) --------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_DB_INDEX=0

# ---- RabbitMQ broker (shared connection; each service's own
# credentials live in its own env/<service>.env) ------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/foc
