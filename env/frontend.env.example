# frontend (EXAMPLE) — combine with shared.env when running compose.
# Copy to frontend.env: cp frontend.env.example frontend.env

# Backend services used by the Next.js server's /api/* rewrites
USER_SERVICE_URL=http://user-service:3000
SUPPLIER_SERVICE_URL=http://supplier-service:3000
CREDIT_SERVICE_URL=http://credit-service:3000
ORDER_SERVICE_URL=http://order-service:3000

# Courier tracking map tiles (Leaflet). NEXT_PUBLIC_* values are inlined into the browser bundle at
# build time (and read at dev-server start), so they must be present when the frontend is built.
# Tile URL template, e.g. a hosted provider or self-hosted tiles: https://tiles.example.com/{z}/{x}/{y}.png
# Leave empty to show a "map tiles not configured" placeholder. Only when NODE_ENV=development does the
# app fall back to the public tile.openstreetmap.org, whose usage policy forbids production/heavy use.
NEXT_PUBLIC_MAP_TILE_URL=
# Attribution HTML shown on the map (required by most tile providers; OSM data needs "OpenStreetMap contributors").
# If empty, the OpenStreetMap attribution is shown.
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=
