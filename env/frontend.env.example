# frontend (EXAMPLE) — combine with shared.env when running compose.
# Copy to frontend.env: cp frontend.env.example frontend.env

# Backend services used by the Next.js server's /api/* rewrites
USER_SERVICE_URL=http://user-service:3000
SUPPLIER_SERVICE_URL=http://supplier-service:3000
CREDIT_SERVICE_URL=http://credit-service:3000
ORDER_SERVICE_URL=http://order-service:3000
NOTIFICATION_SERVICE_URL=http://notification-service:3000
COMMS_SERVICE_URL=http://comms-service:3000

# Same-origin Socket.IO transport path forwarded to Communication Service.
SOCKET_PATH=/socket.io
