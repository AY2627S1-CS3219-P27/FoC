# email-service (EXAMPLE) — combine with shared.env when running compose.
# Copy to email-service.env: cp email-service.env.example email-service.env

SMTP_HOST=papercut
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=foc
SMTP_FROM_EMAIL=noreply@foc.local

# RabbitMQ identity for this service (password: email-service/secrets/rabbitmq_email_password.secret)
EMAIL_SERVICE_RABBITMQ_USER=email-service
