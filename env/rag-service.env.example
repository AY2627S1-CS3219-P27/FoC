# rag-service (EXAMPLE) — combine with shared.env when running compose.
# Copy to rag-service.env: cp rag-service.env.example rag-service.env

# ---- Docker Compose (docker compose up) ------------------------------------
# Interpolated by rag-service/compose.yml. Prefixed RAG_ so another service's
# DB_* values can never reach this one.
RAG_LOG_LEVEL=log
RAG_DB_USERNAME=rag_service
RAG_DB_DATABASE=rag_service
RAG_DB_TEST_HOST_PORT=5443
RAG_DB_MIGRATIONS_RUN=true
# user-service's JWT public key file (relative to rag-service/). Read only: it
# must be the exact key user-service signs with, so point at its own file.
RAG_JWT_PUBLIC_KEY_PATH=../user-service/secrets/jwt_public_key.secret
RAG_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# A fixed name, so evaluation results describe the model actually in use.
RAG_OPENROUTER_CHAT_MODEL=anthropic/claude-haiku-5.5
# Changing this means re-indexing every document.
RAG_OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# Re-index on startup when the help documents have changed
RAG_INDEX_ON_STARTUP=true

# ---- Read by the app itself -------------------------------------------------
# Compose sets these inside the container. They matter only when you run the app
# or the migration CLI directly on your machine (npm run start:dev,
# npm run migration:*), which reads this file (src/database/data-source.ts),
# pointing at the compose database's host port.
NODE_ENV=development
PORT=3000
# fatal | error | warn | log | debug | verbose (each includes the ones before)
LOG_LEVEL=log
DB_HOST=localhost
DB_PORT=5442
DB_USERNAME=rag_service
DB_DATABASE=rag_service
DB_PASSWORD_FILE=./secrets/rag_db_password.secret
# Apply pending migrations on startup (schema is never auto-synchronized)
DB_MIGRATIONS_RUN=true
# user-service's JWT public key (PEM), to verify login tokens
JWT_PUBLIC_KEY_FILE=../user-service/secrets/jwt_public_key.secret
OPENROUTER_API_KEY_FILE=./secrets/openrouter_api_key.secret
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL=anthropic/claude-haiku-5.5
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
SUPPORT_DOCS_PATH=../docs/support
INDEX_ON_STARTUP=true
