# order-service (EXAMPLE) — combine with shared.env when running compose.
# Copy to order-service.env: cp order-service.env.example order-service.env

ORDER_SERVICE_HOST_PORT=3004
ORDER_SERVICE_DB_HOST=order-db
ORDER_SERVICE_DB_PORT=5432
ORDER_SERVICE_DB_HOST_PORT=5436
ORDER_SERVICE_DB_USERNAME=order_service
ORDER_SERVICE_DB_DATABASE=order_service
ORDER_SERVICE_DB_SYNCHRONIZE=true
# Apply drizzle/ migrations on startup; false leaves it to `npm run db:migrate`.
ORDER_SERVICE_DB_MIGRATIONS_RUN=true

# RabbitMQ identity for this service (password: order-service/secrets/rabbitmq_password.secret)
ORDER_SERVICE_RABBITMQ_USER=order-service
RABBITMQ_EXCHANGE=foc.events
RABBITMQ_RETRY_EXCHANGE=foc.order.retry
RABBITMQ_RETRY_RETURN_EXCHANGE=foc.order.back
RABBITMQ_DEAD_LETTER_EXCHANGE=foc.order.dlx
RABBITMQ_PREFETCH=10
RABBITMQ_RETRY_DELAYS_MS=1000,2000,4000,8000,16000

# Transactional outbox
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
OUTBOX_CONFIRM_TIMEOUT_MS=20000
OUTBOX_CLAIM_LEASE_MS=30000
OUTBOX_RETRY_BASE_DELAY_MS=1000
OUTBOX_RETRY_MAX_DELAY_MS=60000
OUTBOX_UNPUBLISHED_WARNING_MS=60000
SWEEP_INTERVAL_MS=60000
RESERVING_CREDIT_TIMEOUT_MS=300000
CREDIT_REPLY_TIMEOUT_MS=120000
CREDIT_RESEND_MAX=3
IDEMPOTENCY_KEY_TTL_MS=604800000
ROLE_BLOCK_TTL_MS=960000
SUPPLIER_RETRY_BASE_MS=1000
SUPPLIER_RETRY_MAX_MS=300000
SUPPLIER_VALIDATION_HOLD_MS=1800000

# Redis (courier last-known position, pub/sub, route cache). REDIS_HOST/PORT/USERNAME come from
# shared.env. ORDER_SERVICE_REDIS_DB_INDEX is mapped to REDIS_DB_INDEX in order-service/compose.yml
# (shared.env's REDIS_DB_INDEX=0 is user-service's), so the two never collide.
ORDER_SERVICE_REDIS_DB_INDEX=1

# Courier tracking
# Seconds a last-known position lives in Redis without a refresh.
TRACKING_LOCATION_TTL_S=120
# Courier updates arriving faster than this are dropped.
TRACKING_MIN_UPDATE_INTERVAL_MS=1000
# SSE comment keepalive interval.
TRACKING_SSE_KEEPALIVE_MS=20000
# Accepted position box: minLon,minLat,maxLon,maxLat (Singapore).
TRACKING_BBOX=103.62,1.22,104.03,1.47
# Cached route lifetime, and how far the courier may move from the route origin before a re-route.
TRACKING_ROUTE_TTL_S=600
TRACKING_REROUTE_DISTANCE_M=50
# Max concurrent tracking SSE streams (over the cap: 429 TOO_MANY_STREAMS)
TRACKING_MAX_STREAMS_PER_ERRAND=5
TRACKING_MAX_STREAMS_PER_USER=10

# OSRM walking router (osrm compose service; run ./scripts/prepare-osrm.sh once first).
# Opt-in: ./scripts/prepare-osrm.sh, then `docker compose --profile routing up -d osrm`.
# Routing degrades to "no route" if it is unreachable (or never started).
OSRM_BASE_URL=http://osrm:5000
OSRM_TIMEOUT_MS=3000
