# order-service (EXAMPLE) — combine with shared.env when running compose.
# Copy to order-service.env: cp order-service.env.example order-service.env

ORDER_SERVICE_HOST_PORT=3004
ORDER_SERVICE_DB_HOST=order-db
ORDER_SERVICE_DB_PORT=5432
ORDER_SERVICE_DB_HOST_PORT=5436
ORDER_SERVICE_DB_USERNAME=order_service
ORDER_SERVICE_DB_DATABASE=order_service
ORDER_SERVICE_DB_SYNCHRONIZE=true

# RabbitMQ identity for this service (password: order-service/secrets/rabbitmq_password.secret)
ORDER_SERVICE_RABBITMQ_USER=order-service
