# notification-service (EXAMPLE) — combine with shared.env when running compose.
# Copy to notification-service.env: cp notification-service.env.example notification-service.env

NOTIFICATION_SERVICE_PORT=3000

# Postgres (TypeORM). notification-db is internal-only
# (password: notification-service/secrets/notification_db_password.secret)
NOTIFICATION_SERVICE_DB_HOST=notification-db
NOTIFICATION_SERVICE_DB_PORT=5432
NOTIFICATION_SERVICE_DB_USERNAME=notification_service
NOTIFICATION_SERVICE_DB_DATABASE=notification_service
# Migrations are applied on startup; the schema is never synchronize-managed.
NOTIFICATION_SERVICE_DB_MIGRATIONS_RUN=true

# RabbitMQ identity for this service (password: notification-service/secrets/rabbitmq_notification_password.secret)
NOTIFICATION_SERVICE_RABBITMQ_USER=notification-service
RABBITMQ_PREFETCH=10
RABBITMQ_RETRY_DELAYS_MS=1000,2000,4000,8000,16000

# user-service's JWT public key, for verifying access tokens (mounted as a
# secret by compose.yml; read-only)
JWT_PUBLIC_KEY_FILE=/run/secrets/jwt_public_key_notification_service

# Web Push VAPID public key handed to browsers (the matching private key lives
# in notification-service/secrets/vapid_private_key.secret, used when sending).
NOTIFICATION_SERVICE_VAPID_PUBLIC_KEY=BCwlfM3d0eD3zBSTPRk3OhG-Xux7zbEumbHGLFOLdYh8CPG35a0Ws0BaMwe7F8R6CGHy03EnOSiRkw3BHzHJuoI
# VAPID contact identity (mailto: or https: URL). The matching private key is
# mounted from notification-service/secrets/vapid_private_key.secret.
NOTIFICATION_SERVICE_VAPID_SUBJECT=mailto:notifications@foc.local
