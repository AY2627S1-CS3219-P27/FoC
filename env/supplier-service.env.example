# supplier-service (EXAMPLE) — combine with shared.env when running compose.
# Copy to supplier-service.env: cp supplier-service.env.example supplier-service.env

# ---- Docker Compose (docker compose up) ------------------------------------
# Interpolated by supplier-service/compose.yml. Prefixed SUPPLIER_ so another
# service's DB_* values can never reach this one.
SUPPLIER_LOG_LEVEL=log
SUPPLIER_DB_USERNAME=supplier_service
SUPPLIER_DB_DATABASE=supplier_service
SUPPLIER_DB_TEST_HOST_PORT=5439
SUPPLIER_DB_MIGRATIONS_RUN=true
SUPPLIER_CAMPUS_MIN_LATITUDE=1.28
SUPPLIER_CAMPUS_MAX_LATITUDE=1.31
SUPPLIER_CAMPUS_MIN_LONGITUDE=103.74
SUPPLIER_CAMPUS_MAX_LONGITUDE=103.79
SUPPLIER_SEED_ON_STARTUP=true
# user-service's JWT public key file (relative to supplier-service/). Read only:
# it must be the exact key user-service signs with, so point at its own file.
SUPPLIER_JWT_PUBLIC_KEY_PATH=../user-service/secrets/jwt_public_key.secret
# Image link returned for suppliers without a photo (F1.2.9); blank = null
SUPPLIER_PLACEHOLDER_IMAGE_URL=
# This service's RabbitMQ login (the connection itself is in shared.env)
SUPPLIER_RABBITMQ_USER=supplier-service
# Read under the same names by compose.yml and by the app, as in credit-service
# and order-service (none of them is in shared.env).
RABBITMQ_EXCHANGE=foc.events
# This service's own retry, return and dead-letter exchanges
RABBITMQ_RETRY_EXCHANGE=foc.supplier.retry
RABBITMQ_RETRY_RETURN_EXCHANGE=foc.supplier.back
RABBITMQ_DEAD_LETTER_EXCHANGE=foc.supplier.dlx
# Messages handled at once; each holds one database connection (pool of 10)
RABBITMQ_PREFETCH=10
# Five increasing waits before a failed message is dead-lettered (F15.7.5)
RABBITMQ_RETRY_DELAYS_MS=1000,2000,4000,8000,16000
# Order Service's supplier-validation requests and our replies (F15.7); the
# routing keys must match the shared contracts
RABBITMQ_SUPPLIER_VALIDATION_QUEUE=supplier-service.order-supplier-validation-requested.v1
RABBITMQ_SUPPLIER_VALIDATION_REQUESTED_ROUTING_KEY=order.supplier-validation-requested.v1
RABBITMQ_SUPPLIER_VALIDATION_COMPLETED_ROUTING_KEY=supplier.validation-completed.v1
# The outbox relay that publishes the replies (F15.7.3)
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
OUTBOX_CONFIRM_TIMEOUT_MS=20000
OUTBOX_CLAIM_LEASE_MS=30000
OUTBOX_RETRY_BASE_DELAY_MS=1000
OUTBOX_RETRY_MAX_DELAY_MS=60000
OUTBOX_UNPUBLISHED_WARNING_MS=60000

# ---- Read by the app itself -------------------------------------------------
# Compose sets these inside the container. They matter only when you run the app
# or the migration CLI directly on your machine (npm run start:dev,
# npm run migration:*), which reads this file (src/database/data-source.ts),
# pointing at the compose database's host port.
NODE_ENV=development
PORT=3000
# fatal | error | warn | log | debug | verbose (each includes the ones before)
LOG_LEVEL=log
DB_HOST=localhost
DB_PORT=5438
DB_USERNAME=supplier_service
DB_DATABASE=supplier_service
DB_PASSWORD_FILE=./secrets/supplier_db_password.secret
# Apply pending migrations on startup (schema is never auto-synchronized)
DB_MIGRATIONS_RUN=true
# NUS campus bounding box every supplier's coordinates must lie in (F1.2.7)
CAMPUS_MIN_LATITUDE=1.28
CAMPUS_MAX_LATITUDE=1.31
CAMPUS_MIN_LONGITUDE=103.74
CAMPUS_MAX_LONGITUDE=103.79
# Import the supplier seed file on startup (safe to re-run: existing ones skip)
SEED_ON_STARTUP=true
SEED_CSV_PATH=../data/csv/supplier-seed-data.csv
# user-service's JWT public key (PEM), to verify login tokens
JWT_PUBLIC_KEY_FILE=../user-service/secrets/jwt_public_key.secret
# Image link returned for suppliers without a photo (F1.2.9); blank = null
PLACEHOLDER_IMAGE_URL=
# RabbitMQ: the connection (RABBITMQ_HOST/PORT/VHOST) is not set here. Compose
# takes it from env/shared.env, and a value in this file would override it
# inside the container; a host run needs them exported (localhost, 5672, /foc).
RABBITMQ_USER=supplier-service
RABBITMQ_PASSWORD_FILE=./secrets/rabbitmq_password.secret
