# credit-service (EXAMPLE) — root-orchestrated app + DB only.
# Combine with shared.env when running compose from the repo root.
# Copy to credit-service.env: cp credit-service.env.example credit-service.env
#
# Test/recovery-only tooling vars (isolated broker, test/recovery DB ports,
# etc.) live in credit-service/.env.example instead — those Compose profiles
# are reserved for tests and are never part of the root stack.

# Application
CREDIT_SERVICE_PORT=3000
CREDIT_SERVICE_HOST_PORT=3003
INITIAL_CREDIT_BALANCE=100

# PostgreSQL (password: credit-service/secrets/credit_db_password.secret)
CREDIT_SERVICE_DB_HOST=credit-db
CREDIT_SERVICE_DB_PORT=5432
CREDIT_SERVICE_DB_HOST_PORT=5435
CREDIT_SERVICE_DB_USERNAME=credit_service
CREDIT_SERVICE_DB_DATABASE=credit_service
# Apply pending migrations when the service starts (set false to run them by hand)
CREDIT_SERVICE_DB_MIGRATIONS_RUN=true

# RabbitMQ identity for this service (password: credit-service/secrets/rabbitmq_password.secret;
# host/port/vhost come from shared.env)
CREDIT_SERVICE_RABBITMQ_USER=credit-service
RABBITMQ_EXCHANGE=foc.events
RABBITMQ_USER_REGISTERED_QUEUE=credit-service.user-registered.v1
RABBITMQ_USER_REGISTERED_ROUTING_KEY=user.registered.v1
RABBITMQ_CREDIT_ACCOUNT_INITIALISED_ROUTING_KEY=credit.account-initialised.v1
RABBITMQ_CREDIT_RESERVATION_QUEUE=credit-service.credit-reservation.v1
RABBITMQ_CREDIT_RESERVATION_ROUTING_KEY=credit.reservation.v1
RABBITMQ_CREDIT_RESERVATION_ADJUSTMENT_QUEUE=credit-service.credit-reservation-adjustment.v1
RABBITMQ_CREDIT_RESERVATION_ADJUSTMENT_ROUTING_KEY=credit.reservation-adjustment.v1
RABBITMQ_CREDIT_RESERVATION_SUCCESS_ROUTING_KEY=credit.reservation-success.v1
RABBITMQ_CREDIT_RESERVATION_REJECTED_ROUTING_KEY=credit.reservation-rejected.v1
RABBITMQ_CREDIT_RESERVATION_ADJUSTMENT_SUCCESS_ROUTING_KEY=credit.reservation-adjustment-success.v1
RABBITMQ_CREDIT_RESERVATION_ADJUSTMENT_REJECTED_ROUTING_KEY=credit.reservation-adjustment-rejected.v1
RABBITMQ_ORDER_ERRAND_COMPLETED_QUEUE=credit-service.order-errand-completed.v1
RABBITMQ_ORDER_ERRAND_COMPLETED_ROUTING_KEY=order.errand-completed.v1
RABBITMQ_ORDER_ERRAND_CANCELLED_QUEUE=credit-service.order-errand-cancelled.v1
RABBITMQ_ORDER_ERRAND_CANCELLED_ROUTING_KEY=order.errand-cancelled.v1
RABBITMQ_CREDIT_TRANSFER_SUCCEEDED_ROUTING_KEY=credit.transfer-succeeded.v1
RABBITMQ_CREDIT_TRANSFER_REJECTED_ROUTING_KEY=credit.transfer-rejected.v1
RABBITMQ_CREDIT_RELEASE_SUCCESS_ROUTING_KEY=credit.release-success.v1
RABBITMQ_CREDIT_RELEASE_REJECTED_ROUTING_KEY=credit.release-rejected.v1
RABBITMQ_RETRY_EXCHANGE=foc.credit.retry
RABBITMQ_RETRY_RETURN_EXCHANGE=foc.credit.back
RABBITMQ_DEAD_LETTER_EXCHANGE=foc.credit.dlx
RABBITMQ_PREFETCH=10
RABBITMQ_RETRY_DELAYS_MS=1000,2000,4000,8000,16000

# Transactional outbox
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
OUTBOX_CONFIRM_TIMEOUT_MS=20000
OUTBOX_CLAIM_LEASE_MS=30000
OUTBOX_RETRY_BASE_DELAY_MS=1000
OUTBOX_RETRY_MAX_DELAY_MS=60000
OUTBOX_UNPUBLISHED_WARNING_MS=60000

# Durable credit operations
CREDIT_OPERATION_CLAIM_LEASE_MS=30000
CREDIT_OPERATION_POLL_INTERVAL_MS=1000
CREDIT_OPERATION_MAX_BACKOFF_MS=60000
CREDIT_OPERATION_STUCK_AFTER_MS=60000
