# comms-service (EXAMPLE)
# Combine with env/shared.env when running Compose from the repository root.

COMMS_SERVICE_PORT=3000
COMMS_SERVICE_HOST_PORT=3006

COMMS_SERVICE_DB_HOST=comms-db
COMMS_SERVICE_DB_PORT=5432
COMMS_SERVICE_DB_HOST_PORT=5437
COMMS_SERVICE_DB_USERNAME=comms_service
COMMS_SERVICE_DB_DATABASE=comms_service

COMMS_JWT_PUBLIC_KEY_PATH=../user-service/secrets/jwt_public_key.secret
COMMS_SERVICE_RABBITMQ_USER=comms-service
RABBITMQ_EXCHANGE=foc.events
RABBITMQ_ORDER_ERRAND_ACCEPTED_QUEUE=comms-service.order-errand-accepted.v1
RABBITMQ_ORDER_ERRAND_DELIVERED_QUEUE=comms-service.order-errand-delivered.v1
RABBITMQ_ORDER_COURIER_CANCELLED_QUEUE=comms-service.order-courier-cancelled.v1
RABBITMQ_ORDER_ERRAND_CANCELLED_QUEUE=comms-service.order-errand-cancelled.v1
RABBITMQ_RETRY_EXCHANGE=foc.comms.retry
RABBITMQ_RETRY_RETURN_EXCHANGE=foc.comms.back
RABBITMQ_DEAD_LETTER_EXCHANGE=foc.comms.dlx
RABBITMQ_RETRY_DELAYS_MS=1000,2000,4000,8000,16000

SOCKET_PATH=/socket.io
SOCKET_ALLOWED_ORIGINS=http://localhost:3000
SOCKET_TRANSPORT=websocket
