{
  "name": "notification-service",
  "version": "1.0.0",
  "description": "Notification service for Friend on Campus",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "obs:deps": "npm install --no-audit --no-fund --prefix ../packages/observability",
    "obs:build": "npm run build --prefix ../packages/observability",
    "obs:link": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('node_modules/@foc/observability', { recursive: true, force: true })\" && npm install --install-links --no-save --no-audit --no-fund ../packages/observability",
    "shared:prepare": "npm run obs:build && npm run obs:link",
    "postinstall": "npm run obs:deps",
    "prebuild": "npm run shared:prepare",
    "build": "nest build",
    "prestart": "npm run shared:prepare",
    "start": "nest start",
    "prestart:dev": "npm run shared:prepare",
    "start:dev": "nest start --watch --preserveWatchOutput",
    "start:prod": "node dist/main",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "oxlint --type-aware src/",
    "pretest": "npm run shared:prepare",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@foc/observability": "file:../packages/observability",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/typeorm": "^12.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "joi": "^18.2.9",
    "nestjs-pino": "^5.3.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.11",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  }
}
