{
  "name": "comms-service",
  "version": "0.0.1",
  "description": "Communication service for Friend on Campus",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "npm@11.18.0",
  "scripts": {
    "contracts:build": "npm run build --prefix ../packages/contracts",
    "contracts:install": "npm install --no-audit --no-fund --prefix ../packages/contracts",
    "auth:deps": "npm install --no-audit --no-fund --prefix ../packages/auth",
    "auth:build": "npm run build --prefix ../packages/auth",
    "auth:link": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('node_modules/@foc/auth', { recursive: true, force: true })\" && npm install --install-links --no-save --no-audit --no-fund ../packages/auth",
    "obs:deps": "npm install --no-audit --no-fund --prefix ../packages/observability",
    "obs:build": "npm run build --prefix ../packages/observability",
    "obs:link": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('node_modules/@foc/observability', { recursive: true, force: true })\" && npm install --install-links --no-save --no-audit --no-fund ../packages/observability",
    "shared:prepare": "npm run contracts:build && npm run auth:build && npm run auth:link && npm run obs:build && npm run obs:link",
    "postinstall": "npm run contracts:install && npm run auth:deps && npm run obs:deps",
    "prebuild": "npm run shared:prepare",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "prestart": "npm run shared:prepare",
    "start": "nest start",
    "prestart:dev": "npm run shared:prepare",
    "start:dev": "nest start --watch --preserveWatchOutput",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/",
    "pretest": "npm run shared:prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "typeorm": "typeorm-ts-node-esm",
    "migration:create": "typeorm-ts-node-esm migration:create",
    "migration:generate": "typeorm-ts-node-esm -d src/database/data-source.ts migration:generate",
    "migration:run": "typeorm-ts-node-esm -d src/database/data-source.ts migration:run --transaction all",
    "migration:show": "typeorm-ts-node-esm -d src/database/data-source.ts migration:show",
    "migration:revert": "typeorm-ts-node-esm -d src/database/data-source.ts migration:revert --transaction all",
    "migration:run:prod": "typeorm -d dist/database/data-source.js migration:run --transaction all",
    "migration:show:prod": "typeorm -d dist/database/data-source.js migration:show",
    "migration:revert:prod": "typeorm -d dist/database/data-source.js migration:revert --transaction all"
  },
  "dependencies": {
    "@foc/auth": "file:../packages/auth",
    "@foc/contracts": "file:../packages/contracts",
    "@foc/observability": "file:../packages/observability",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/platform-socket.io": "^12.0.1",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/typeorm": "^12.0.1",
    "@nestjs/websockets": "^12.0.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "amqplib": "^2.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "joi": "^18.2.9",
    "nestjs-pino": "^5.3.1",
    "pg": "^8.23.0",
    "redis": "^6.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/amqplib": "^0.10.8",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  }
}
