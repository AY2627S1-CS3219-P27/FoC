# Host-side migration integration tests. Use only a disposable test database.
COMMS_SERVICE_DB_TEST_HOST_PORT=5441
DB_HOST=127.0.0.1
DB_PORT=5441
DB_USERNAME=comms_service
DB_DATABASE=comms_service_test
DB_PASSWORD_FILE=./secrets/comms_db_password.secret

# Host-side isolated RabbitMQ permission test.
COMMS_RABBITMQ_TEST_HOST_PORT=5678
COMMS_RABBITMQ_TEST_MANAGEMENT_HOST_PORT=15678
RABBITMQ_USER=comms-service
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5678
RABBITMQ_VHOST=/foc
RABBITMQ_PASSWORD_FILE=./secrets/rabbitmq_password.secret
RABBITMQ_PUBSUB_EXCHANGE=foc.pubsub
RABBITMQ_EVENTS_QUEUE=comms-service.events

# Test-only publisher for lifecycle fixtures. This URL targets the disposable,
# loopback-only broker's test administrator; never use it in deployment and
# never grant domain publication permission to comms-service.
RABBITMQ_FIXTURE_URL=amqp://guest:guest@127.0.0.1:5678/%2Ffoc

# Operator-only DLQ inspection/redrive credentials. Do not use the runtime
# comms-service identity: it is intentionally denied writes to foc.events.
RABBITMQ_OPERATOR_USER=foc-operator
RABBITMQ_OPERATOR_HOST=127.0.0.1
RABBITMQ_OPERATOR_PORT=5672
RABBITMQ_OPERATOR_VHOST=/foc
RABBITMQ_OPERATOR_PASSWORD_FILE=./secrets/rabbitmq_operator_password.secret
