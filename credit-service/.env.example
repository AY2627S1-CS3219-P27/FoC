# Application
NODE_ENV=development
PORT=3000
CREDIT_SERVICE_HOST_PORT=3003
LOG_LEVEL=log
INITIAL_CREDIT_BALANCE=100

# PostgreSQL
DB_HOST=credit-db
DB_PORT=5432
DB_HOST_PORT=5435
DB_TEST_HOST_PORT=5436
DB_RECOVERY_HOST_PORT=5437
DB_USERNAME=credit_service
DB_DATABASE=credit_service
DB_PASSWORD_FILE=/run/secrets/credit_db_password

# RabbitMQ runtime (shared root broker)
RABBITMQ_USER=credit-service
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/foc
RABBITMQ_PASSWORD_FILE=/run/secrets/rabbitmq_password_credit_service

# Isolated messaging/recovery test broker tooling only
RABBITMQ_USERNAME=credit_service_test
RABBITMQ_PASSWORD=replace-me
RABBITMQ_URL=amqp://credit_service_test:replace-me@localhost:5675
RABBITMQ_HOST_PORT=5675
RABBITMQ_MANAGEMENT_HOST_PORT=15675
RABBITMQ_RECOVERY_HOST_PORT=5676
RABBITMQ_RECOVERY_MANAGEMENT_HOST_PORT=15676
RABBITMQ_EXCHANGE=foc.events
RABBITMQ_USER_REGISTERED_QUEUE=credit-service.user-registered.v1
RABBITMQ_USER_REGISTERED_ROUTING_KEY=user.registered.v1
RABBITMQ_CREDIT_ACCOUNT_INITIALISED_ROUTING_KEY=credit.account-initialised.v1
RABBITMQ_RETRY_EXCHANGE=foc.credit.retry
RABBITMQ_RETRY_RETURN_EXCHANGE=foc.credit.back
RABBITMQ_DEAD_LETTER_EXCHANGE=foc.credit.dlx
RABBITMQ_PREFETCH=10
RABBITMQ_RETRY_DELAYS_MS=1000,2000,4000,8000,16000

# Transactional outbox
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
OUTBOX_CLAIM_LEASE_MS=30000
OUTBOX_UNPUBLISHED_WARNING_MS=60000
