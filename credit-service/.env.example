# credit-service — local test/recovery tooling ONLY (EXAMPLE).
# Copy to .env: cp .env.example .env
#
# These Compose profiles (`--profile test` / `--profile recovery`) and the
# npm test scripts that drive them are reserved for tests and run standalone
# from this folder; they never run as part of the root stack. The normal app
# + DB config lives in the root env/credit-service.env.example instead.

# PostgreSQL — local test/recovery profiles only
DB_TEST_HOST_PORT=5436
DB_RECOVERY_HOST_PORT=5437
DB_USERNAME=credit_service
DB_PASSWORD_FILE=/run/secrets/credit_db_password
RECOVERY_DB_PASSWORD_FILE=./secrets/credit_db_password.secret

# Isolated messaging/recovery test broker tooling only
RABBITMQ_USERNAME=credit_service_test
RABBITMQ_PASSWORD=replace-me
RABBITMQ_URL=amqp://credit_service_test:replace-me@localhost:5675
RABBITMQ_HOST_PORT=5675
RABBITMQ_MANAGEMENT_HOST_PORT=15675
RABBITMQ_RECOVERY_HOST_PORT=5676
RABBITMQ_RECOVERY_MANAGEMENT_HOST_PORT=15676
