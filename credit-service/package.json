{
  "name": "credit-service",
  "version": "0.0.1",
  "description": "Credit service for Friend on Campus",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "npm@11.18.0",
  "scripts": {
    "contracts:build": "npm run build --prefix ../packages/contracts",
    "contracts:install": "npm install --no-audit --no-fund --prefix ../packages/contracts",
    "auth:deps": "npm install --no-audit --no-fund --prefix ../packages/auth",
    "auth:build": "npm run build --prefix ../packages/auth",
    "auth:link": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('node_modules/@foc/auth', { recursive: true, force: true })\" && npm install --install-links --no-audit --no-fund ../packages/auth",
    "postinstall": "npm run contracts:install && npm run auth:deps",
    "prebuild": "npm run contracts:build && npm run auth:build && npm run auth:link",
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "prestart": "npm run contracts:build && npm run auth:build && npm run auth:link",
    "start": "nest start",
    "prestart:dev": "npm run contracts:build && npm run auth:build && npm run auth:link",
    "start:dev": "nest start --watch --preserveWatchOutput",
    "prestart:debug": "npm run contracts:build && npm run auth:build && npm run auth:link",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint src/ test/",
    "pretest": "npm run contracts:build && npm run auth:build && npm run auth:link",
    "test": "vitest run",
    "pretest:watch": "npm run contracts:build && npm run auth:build && npm run auth:link",
    "test:watch": "vitest",
    "pretest:cov": "npm run contracts:build && npm run auth:build && npm run auth:link",
    "test:cov": "vitest run --coverage",
    "pretest:debug": "npm run contracts:build && npm run auth:build && npm run auth:link",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "pretest:e2e": "npm run contracts:build && npm run auth:build && npm run auth:link",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "pretest:integration": "npm run contracts:build && npm run auth:build && npm run auth:link",
    "test:integration": "vitest run --config ./vitest.config.integration.ts",
    "pretest:messaging": "npm run contracts:build && npm run auth:build && npm run auth:link",
    "test:messaging": "vitest run --config ./vitest.config.messaging.ts",
    "test:rabbitmq-permissions": "node scripts/verify-rabbitmq-permissions.mjs",
    "pretest:recovery": "npm run contracts:build && npm run auth:build && npm run auth:link",
    "test:recovery": "node scripts/run-recovery-tests.mjs",
    "event:publish:user-registered": "node scripts/publish-event-fixture.mjs test/fixtures/user-registered.v1.json",
    "db:test:up": "docker compose --profile test up -d --wait credit-db-test",
    "db:test:down": "docker compose --profile test rm -sfv credit-db-test",
    "typeorm": "typeorm-ts-node-esm",
    "migration:create": "typeorm-ts-node-esm migration:create",
    "migration:generate": "typeorm-ts-node-esm -d src/database/data-source.ts migration:generate",
    "migration:run": "typeorm-ts-node-esm -d src/database/data-source.ts migration:run --transaction all",
    "migration:show": "typeorm-ts-node-esm -d src/database/data-source.ts migration:show",
    "migration:revert": "typeorm-ts-node-esm -d src/database/data-source.ts migration:revert --transaction all",
    "migration:run:prod": "typeorm -d dist/database/data-source.js migration:run --transaction all",
    "migration:show:prod": "typeorm -d dist/database/data-source.js migration:show",
    "migration:revert:prod": "typeorm -d dist/database/data-source.js migration:revert --transaction all"
  },
  "dependencies": {
    "@foc/auth": "file:../packages/auth",
    "@foc/contracts": "file:../packages/contracts",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/observe": "^0.1.8",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/typeorm": "^12.0.1",
    "amqplib": "^2.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "joi": "^18.2.9",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/amqplib": "^0.10.8",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  }
}
