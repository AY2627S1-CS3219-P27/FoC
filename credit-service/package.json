{
  "name": "credit-service",
  "version": "0.0.1",
  "description": "Credit service for Friend on Campus",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "npm@11.18.0",
  "scripts": {
    "contracts:sync:source": "node scripts/sync-contracts.mjs source",
    "contracts:sync:dist": "node scripts/sync-contracts.mjs dist",
    "prebuild": "npm run contracts:sync:source",
    "build": "nest build",
    "postbuild": "npm run contracts:sync:dist",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "prestart": "npm run contracts:sync:source",
    "start": "nest start",
    "prestart:dev": "npm run contracts:sync:source",
    "start:dev": "nest start --watch",
    "prestart:debug": "npm run contracts:sync:source",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint src/ test/",
    "pretest": "npm run contracts:sync:source",
    "test": "vitest run",
    "pretest:watch": "npm run contracts:sync:source",
    "test:watch": "vitest",
    "pretest:cov": "npm run contracts:sync:source",
    "test:cov": "vitest run --coverage",
    "pretest:debug": "npm run contracts:sync:source",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "pretest:e2e": "npm run contracts:sync:source",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "pretest:integration": "npm run contracts:sync:source",
    "test:integration": "vitest run --config ./vitest.config.integration.ts",
    "db:test:up": "docker compose --profile test up -d --wait credit-db-test",
    "db:test:down": "docker compose --profile test rm -sfv credit-db-test",
    "typeorm": "typeorm-ts-node-esm",
    "migration:create": "typeorm-ts-node-esm migration:create",
    "migration:generate": "typeorm-ts-node-esm -d src/database/data-source.ts migration:generate",
    "migration:run": "typeorm-ts-node-esm -d src/database/data-source.ts migration:run --transaction all",
    "migration:show": "typeorm-ts-node-esm -d src/database/data-source.ts migration:show",
    "migration:revert": "typeorm-ts-node-esm -d src/database/data-source.ts migration:revert --transaction all",
    "migration:run:prod": "typeorm -d dist/database/data-source.js migration:run --transaction all",
    "migration:show:prod": "typeorm -d dist/database/data-source.js migration:show",
    "migration:revert:prod": "typeorm -d dist/database/data-source.js migration:revert --transaction all"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/observe": "^0.1.8",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/typeorm": "^12.0.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "amqplib": "^2.0.1",
    "dotenv": "^17.4.2",
    "joi": "^18.2.9",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/amqplib": "^0.10.8",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  }
}
